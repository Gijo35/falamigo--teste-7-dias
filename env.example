# ===== FALAMIGO BACKEND — copie para .env e preencha (NUNCA suba .env no git) =====
PORT=3000
# Chave longa e aleatoria: gere com  openssl rand -hex 32
JWT_SECRET=troque_por_chave_longa_e_aleatoria
DB_FILE=./falamigo.db
# Regras comerciais (servidor = autoridade)
TRIAL_DIAS=7
UNLOCK_VALUE=9.90
# Asaas — comece em sandbox: https://sandbox.asaas.com
ASAAS_ENV=sandbox
ASAAS_API_KEY=$aact_YOUR_SANDBOX_KEY_HERE
# Token QUE VOCE DEFINE no painel Asaas -> Webhooks -> token de autenticacao
ASAAS_WEBHOOK_TOKEN=defina_um_token_grande_e_secreto
# Origem permitida do front-end (GitHub Pages, app, etc.)
FRONTEND_URL=https://seu-usuario.github.io
